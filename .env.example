# GEMINI_API_KEY: Required for Gemini AI API calls and fallback AI translations.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_TRANSLATE_API_KEY: Optional Google Cloud Translation API Key.
# If provided, official Google Translate REST API endpoints will be used.
GOOGLE_TRANSLATE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
